// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "cmd-alt-i": "editor::ToggleEditPrediction",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w k": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-w shift-h": "vim::ResizePaneLeft",
      "ctrl-w shift-l": "vim::ResizePaneRight",
      "ctrl-w shift-k": "vim::ResizePaneUp",
      "ctrl-w shift-j": "vim::ResizePaneDown",
    },
  },
  {
    "bindings": {
      "cmd-r": [
        "task::Spawn",
        {
          "task_name": "Go Run Current File"
        }
      ]
    }
  }
]
